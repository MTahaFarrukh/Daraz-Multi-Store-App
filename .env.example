# Daraz Open Platform — Pakistan (PK)
# Register app: https://open.daraz.com/
# Never commit real credentials.

DARAZ_APP_KEY=
DARAZ_APP_SECRET=

# OAuth access token for ONE authorized seller store.
# Obtain via seller authorization flow (see docs/DARAZ_API_FINDINGS.md).
DARAZ_ACCESS_TOKEN=

# Optional — used by refresh_token() when testing token renewal.
DARAZ_REFRESH_TOKEN=

# Pakistan REST base URL (official)
DARAZ_API_BASE=https://api.daraz.pk/rest

# OAuth authorize URL (manual browser step)
DARAZ_OAUTH_AUTHORIZE=https://api.daraz.pk/oauth/authorize

# Callback URL registered in App Console (must match exactly)
DARAZ_REDIRECT_URI=http://localhost:8765/callback
