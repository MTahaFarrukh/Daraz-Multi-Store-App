# Daraz Open Platform — Pakistan (PK) — Phase 2
# Register app: https://open.daraz.com/
# Callback URL in App Console MUST match DARAZ_REDIRECT_URI exactly.
# Never commit .env or data/tokens.json

DARAZ_APP_KEY=
DARAZ_APP_SECRET=

# OAuth callback (must match App Console registration)
DARAZ_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback

# Pakistan REST base URL (official)
DARAZ_API_BASE=https://api.daraz.pk/rest

# OAuth authorize URL
DARAZ_OAUTH_AUTHORIZE=https://api.daraz.pk/oauth/authorize

# Optional: lower bound for GetOrders during smoke test
POC_CREATED_AFTER=2026-01-01T00:00:00+05:00

# Legacy Phase 1 vars (not required when using OAuth flow + data/tokens.json)
# DARAZ_ACCESS_TOKEN=
# DARAZ_REFRESH_TOKEN=
