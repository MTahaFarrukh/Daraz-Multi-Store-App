# Daraz Multi-Store — Pakistan (PK) — Phase 1A multi-tenant
# Register app: https://open.daraz.com/
# Callback URL in App Console MUST match DARAZ_REDIRECT_URI exactly.
# Never commit .env, data/tokens.json, or data/.token_key

DARAZ_APP_KEY=
DARAZ_APP_SECRET=

# OAuth callback (must match App Console registration)
DARAZ_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback

# Pakistan REST base URL (official)
DARAZ_API_BASE=https://api.daraz.pk/rest

# OAuth authorize URL
DARAZ_OAUTH_AUTHORIZE=https://api.daraz.pk/oauth/authorize

# Optional: Fernet key for encrypting Daraz tokens at rest
# DARAZ_TOKEN_KEY=

# Optional: persistent data directory (Render disk mount: /var/data)
# DARAZ_DATA_DIR=/var/data

# --- Phase 1A: Supabase Auth + Postgres (modern API keys) ---
# Project URL (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable key (browser-safe). Settings → API Keys → Publishable
# Used by the frontend Supabase client only.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (SERVER ONLY — never expose to the browser).
# Settings → API Keys → Secret. Not used for user JWT verification.
# Reserved for privileged server-side Supabase Admin API calls if needed later.
SUPABASE_SECRET_KEY=

# Application database (prefer Supabase Postgres connection string)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Auth verification (preferred): JWKS at
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# No shared JWT secret is required for new Supabase projects.

# Legacy-only fallback (older projects that still issue HS256 user JWTs):
# SUPABASE_JWT_SECRET=

# production|prod disables /docs and openapi
# ENVIRONMENT=production

# Controlled legacy vault import (default OFF). Never enable permanently in prod.
# ALLOW_LEGACY_DATA_IMPORT=false

# Optional: serve legacy static HTML UI instead of React SPA at /
# SERVE_LEGACY_UI=false

# Label PDF: fidelity (default, matches Seller Center) or fast (quicker, may differ)
# LABEL_PRINT_MODE=fidelity

# Optional: lower bound for GetOrders during smoke test
POC_CREATED_AFTER=2026-01-01T00:00:00+05:00

# Legacy Phase 1 vars (not required when using OAuth flow)
# DARAZ_ACCESS_TOKEN=
# DARAZ_REFRESH_TOKEN=
